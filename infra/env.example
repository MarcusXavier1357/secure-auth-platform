# Copie para .env (na pasta infra/) antes de subir o docker compose.

POSTGRES_USER=auth
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=auth

# Obrigatórios — sem default por segurança
JWT_SECRET=gere-um-segredo-longo-e-aleatorio
ADMIN_PASSWORD=senha-inicial-do-admin

ADMIN_EMAIL=admin@local.dev

# true em produção (exige HTTPS para o cookie de refresh)
COOKIE_SECURE=false
