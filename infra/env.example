# Copie para .env (na pasta infra/) antes de subir o docker compose.
#   Windows: copy env.example .env
#   Linux/macOS: cp env.example .env

# --- PostgreSQL ---
# Credenciais do container postgres. A API monta DATABASE_URL automaticamente.
# Só aplicam na PRIMEIRA subida do volume. Banco já existente: ALTER USER ou down -v.
POSTGRES_USER=auth
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=auth

# --- Autenticação da aplicação ---
# JWT RS256: a imagem Docker gera chaves em /app/keys/ no build.
# Dev local (go run): gere em backend/keys/ com:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# JWT_PRIVATE_KEY_PATH e JWT_PUBLIC_KEY_PATH (default: keys/private.pem e keys/public.pem)

# Senha do admin criado no primeiro boot. Obrigatório, sem default.
# Mudar depois não altera usuário já existente no banco.
ADMIN_PASSWORD=senha-inicial-do-admin

# Email do admin no primeiro boot.
ADMIN_EMAIL=admin@local.dev

# Cookie do refresh token: false em dev (http://localhost).
# true em produção — exige HTTPS, senão a sessão quebra no F5.
COOKIE_SECURE=false

# --- Segurança (plano3) ---
# GeoLite2 Country (.mmdb). Vazio = geo desabilitado (sem viagem impossível).
# GEOIP_DB_PATH=/app/geoip/GeoLite2-Country.mmdb
# IMPOSSIBLE_TRAVEL_WINDOW_MINUTES=30
# ARGON2_MEMORY=65536
